# Paid model calls stay off until MODEL in config.py is enabled with an
# explicit model id, prices from your provider, and a daily dollar budget.
# ANTHROPIC_API_KEY=

# Optional: a private Solana RPC (Helius, Triton, QuickNode). Public RPC rate-limits fast.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Alerts are OFF unless ALERTS_ENABLED is exactly true. Tokens alone do nothing.
ALERTS_ENABLED=false
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Stocks mode: Alpaca PAPER keys only. The client is constructed paper=True
# and refused if the base URL is not the paper host.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
